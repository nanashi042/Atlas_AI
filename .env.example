APP_NAME=Atlas AI
APP_VERSION=1.0.0
ENVIRONMENT=development
# Set `DATABASE_URL` to a Postgres URL (e.g. from Supabase/Neon).
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
LOG_LEVEL=INFO

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-latest

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY

# Minimum allowed value is 5. Defaults to 15 when omitted.
PRICE_ALERT_INTERVAL_MINUTES=15

# PDF document analysis limits. Extracted text is only held temporarily.
DOCUMENT_MAX_CHARACTERS=24000
DOCUMENT_MAX_PAGES=40
TELEGRAM_MAX_MESSAGE_LENGTH=3900
